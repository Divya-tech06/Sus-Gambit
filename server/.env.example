# ============================================================
# Chess Impostor — Server Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# For production, add connection_limit to control the pool size:
#   postgresql://user:pass@host:5432/chess_impostor?connection_limit=20&connect_timeout=10
DATABASE_URL="postgresql://user:password@localhost:5432/chess_impostor?schema=public"

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── JWT Secrets ───────────────────────────────────────────────
# REQUIRED in production. Use strong random values (64+ hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will REFUSE TO START if these are the dev defaults in production.
JWT_ACCESS_SECRET="CHANGE_ME_use_crypto_randomBytes_64_hex"
JWT_REFRESH_SECRET="CHANGE_ME_use_crypto_randomBytes_64_hex_different"

# ── CORS / Frontend origin ───────────────────────────────────
# Single origin or comma-separated list (no trailing slashes):
#   CLIENT_ORIGIN="https://app.example.com"
#   CLIENT_ORIGIN="https://app.example.com,https://www.app.example.com"
CLIENT_ORIGIN="https://app.example.com"

# ── Reverse proxy / WebSocket notes ──────────────────────────
# If using Nginx, add these to your server block:
#   proxy_http_version 1.1;
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection "upgrade";
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
