# ============================================================
# Chess Impostor — Client Environment Variables
# Copy this file to .env.local for development.
# For production, set these in your hosting provider's dashboard.
# DO NOT commit .env.local to version control.
# ============================================================

# ── Backend API URL ───────────────────────────────────────────
# The full URL of the backend server (no trailing slash).
# Dev:  http://localhost:4000
# Prod: https://api.example.com
VITE_API_BASE="https://api.example.com"

# ── Socket.IO URL ─────────────────────────────────────────────
# Usually the same as the backend URL (Socket.IO shares the HTTP server).
# Dev:  http://localhost:4000
# Prod: https://api.example.com
VITE_SOCKET_URL="https://api.example.com"

# ── Notes ─────────────────────────────────────────────────────
# Both VITE_API_BASE and VITE_SOCKET_URL are REQUIRED.
# The app will throw a clear error at startup if either is missing in production.
